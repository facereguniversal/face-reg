{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://face-reg-production.up.railway.app/api/$1"
    },
    {
      "source": "/capture",
      "destination": "/frontend/capture/index.html"
    },
    {
      "source": "/capture/",
      "destination": "/frontend/capture/index.html"
    },
    {
      "source": "/capture/(.*)",
      "destination": "/frontend/capture/$1"
    },
    {
      "source": "/checkin",
      "destination": "/frontend/checkin/index.html"
    },
    {
      "source": "/checkin/",
      "destination": "/frontend/checkin/index.html"
    },
    {
      "source": "/checkin/(.*)",
      "destination": "/frontend/checkin/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/capture/index.html"
    }
  ]
}
