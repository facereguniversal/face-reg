{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://face-reg-production.up.railway.app/api/:match*"
    },
    {
      "source": "/capture",
      "destination": "/frontend/capture/index.html"
    },
    {
      "source": "/capture/:path*",
      "destination": "/frontend/capture/:path*"
    },
    {
      "source": "/checkin",
      "destination": "/frontend/checkin/index.html"
    },
    {
      "source": "/checkin/:path*",
      "destination": "/frontend/checkin/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/capture",
      "permanent": false
    }
  ]
}
