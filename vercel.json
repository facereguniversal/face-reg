{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://face-reg-production.up.railway.app/api/:match*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/capture",
      "permanent": false
    }
  ]
}
