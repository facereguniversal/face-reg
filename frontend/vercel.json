{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://face-reg-production.up.railway.app/api/$1"
    },
    {
      "source": "/capture",
      "destination": "/capture/index.html"
    },
    {
      "source": "/capture/(.*)",
      "destination": "/capture/$1"
    },
    {
      "source": "/checkin",
      "destination": "/checkin/index.html"
    },
    {
      "source": "/checkin/(.*)",
      "destination": "/checkin/$1"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/capture",
      "permanent": false
    }
  ]
}
