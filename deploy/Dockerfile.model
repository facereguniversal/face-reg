FROM python:3.11-slim

WORKDIR /app

# System deps: OpenCV runtime libs + C++ compiler for insightface Cython build
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 \
        build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY model_server/requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY model_server/ ./

EXPOSE 8001
CMD ["sh", "-c", "uvicorn embed:app --host 0.0.0.0 --port ${PORT:-8001}"]
