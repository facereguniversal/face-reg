# Copy to deploy/.env.production and fill in real values (never commit .env.production).
# Validate: ./scripts/validate-env.sh
# Bootstrap deploy: ./scripts/bootstrap-production.sh

# ---------------------------------------------------------------------------
# TLS / reverse proxy (Caddy)
# ---------------------------------------------------------------------------
# Public hostname served by Caddy (use localhost for self-signed lab deploys).
DOMAIN=faces.example.com

# ---------------------------------------------------------------------------
# PostgreSQL (password must match DATABASE_URL)
# ---------------------------------------------------------------------------
POSTGRES_USER=faceuser
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=facedb

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=replace-with-openssl-rand-hex-32
DATABASE_URL=postgresql+asyncpg://faceuser:replace-with-strong-db-password@db:5432/facedb

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

MODEL_SERVER_URL=http://model_server:8001
SIMILARITY_THRESHOLD=0.6
CHECKIN_SIMILARITY_THRESHOLD=0.6
CHECKIN_COOLDOWN_SECONDS=300
# Format: device_id:long-random-token (comma-separated for multiple kiosks)
CHECKIN_DEVICE_TOKENS=kiosk-lobby:replace-with-long-random-token

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# HTTPS origins that may call the API from a browser (no wildcards in production).
CORS_ORIGINS=https://faces.example.com
CORS_ALLOW_CREDENTIALS=false
BOOTSTRAP_ON_STARTUP=false

# Hotel / kiosk demo: set true to serve /demo/* from the API via Caddy (same DOMAIN).
# Leave false for API-only production; host static UIs separately if needed.
ENABLE_DEMO_UI=false

# Docker bridge / private networks — Caddy reaches the API over the compose network.
TRUSTED_PROXY_IPS=172.16.0.0/12

LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Model server
# ---------------------------------------------------------------------------
LIVENESS_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# Observability (Grafana binds 127.0.0.1:3000 on the host)
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password
