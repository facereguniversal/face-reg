# Environment variables for the face-recognition service.
# Copy to .env and fill in real values.

# Runtime
ENVIRONMENT=development
ENABLE_DEMO_UI=true
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760

# Database
DATABASE_URL=postgresql+asyncpg://faceuser:facepass@localhost:5432/facedb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# CORS (comma-separated origins; use explicit list in production)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
TRUSTED_PROXY_IPS=

# JWT secrets
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Model server
MODEL_SERVER_URL=http://localhost:8001

# FAISS
FAISS_INDEX_PATH=./data/faiss.index
FAISS_MAP_PATH=./data/faiss_id_map.json

# Storage
STORAGE_BACKEND=local
# S3_BUCKET=my-face-images
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Matching threshold (cosine similarity)
SIMILARITY_THRESHOLD=0.6

# Kiosk check-in
CHECKIN_SIMILARITY_THRESHOLD=0.6
CHECKIN_COOLDOWN_SECONDS=300
CHECKIN_DEVICE_TOKENS=demo-kiosk:demo-token

# Liveness / anti-spoofing
# Mount a MiniFASNet/Silent-Face-Anti-Spoofing-compatible ONNX model here for
# production use. Without a model, the service uses a heuristic fallback.
# LIVENESS_MODEL_PATH=/models/minifasnet.onnx
LIVENESS_THRESHOLD=0.5

# Demo bootstrap
BOOTSTRAP_ON_STARTUP=false
BOOTSTRAP_ADMIN_NAME=Demo Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me
# BOOTSTRAP_USERS_FILE=/app/seeds/demo-users.json
